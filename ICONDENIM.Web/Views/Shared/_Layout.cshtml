<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - ICONDENIM</title>
    <meta name="description" content="ICONDENIM - website bán quần áo denim, áo thun, quần jeans, phụ kiện thời trang." />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="site-header">
    <div class="nav-shell">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <span class="brand-mark">ID</span>
            <span>ICONDENIM</span>
        </a>
        <nav class="main-nav">
            <a asp-controller="Home" asp-action="Index">Trang chủ</a>
            <a asp-controller="Products" asp-action="Search">Sản phẩm</a>
            <a asp-controller="Products" asp-action="Search" asp-route-q="denim">Denim</a>
            <a asp-controller="Products" asp-action="Search" asp-route-q="hot">Hàng hot</a>
        </nav>
        <form asp-controller="Products" asp-action="Search" method="get" class="top-search">
            <input name="q" placeholder="Tìm áo, jeans, denim..." />
            <button aria-label="Tìm kiếm">⌕</button>
        </form>
        <div class="nav-actions">
            @if (Context.Session.GetInt32("CustomerUserID").HasValue)
            {
                <span class="hello-user">@Context.Session.GetString("CustomerName")</span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="inline">
                    <button class="link-button">Đăng xuất</button>
                </form>
            }
            else
            {
                <a class="ghost-link" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                <a class="pill-link" asp-controller="Account" asp-action="Register">Đăng ký</a>
            }
            <a class="admin-entry" asp-controller="Admin" asp-action="Login">Admin</a>
        </div>
    </div>
</header>
<main class="page-wrap">
    @RenderBody()
</main>
<footer class="site-footer">
    <div>
        <b>ICONDENIM</b>
        <p>Website bán quần áo | COD/VNPay | Giao hàng toàn quốc | Đổi hàng 7 ngày</p>
    </div>
    <span>Hotline 028-7306-8499</span>
</footer>
@RenderSection("Scripts", required: false)
</body>
</html>
