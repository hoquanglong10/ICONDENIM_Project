@model RegisterViewModel
@{
    ViewData["Title"] = "Tạo tài khoản mới";
}
<section class="auth-center-page">
    <div class="auth-breadcrumb">Trang chủ / Tài khoản / <b>Tạo tài khoản mới</b></div>
    <div class="auth-box-v2 register-box-v2 register-box-v3">
        <h1>Tạo tài khoản mới</h1>
        <form method="post" class="auth-form v2-auth-form register-grid">
            <div asp-validation-summary="ModelOnly" class="validation-box full"></div>
            <input asp-for="HoTen" placeholder="Họ và tên" />
            <input asp-for="SoDienThoai" placeholder="Số điện thoại" />
            <input asp-for="Email" placeholder="Email" />
            <input asp-for="NgaySinh" type="date" />
            <input asp-for="MatKhau" placeholder="Mật khẩu" />
            <input asp-for="NhapLaiMatKhau" placeholder="Nhập lại mật khẩu" />
            <input class="full" asp-for="DiaChiGiaoHang" placeholder="Địa chỉ giao hàng" />
            <button class="btn dark-btn full">Đăng ký</button>
        </form>
        <div class="auth-bottom-links auth-bottom-single">
            <a asp-controller="Account" asp-action="Login">Đã có tài khoản? Đăng nhập</a>
        </div>
    </div>
</section>