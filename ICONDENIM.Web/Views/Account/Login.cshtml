@model LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập tài khoản";
}
<section class="auth-center-page">
    <div class="auth-breadcrumb">Trang chủ / Tài khoản / <b>Đăng nhập</b></div>
    <div class="auth-box-v2 login-box-v3">
        <h1>Đăng nhập tài khoản</h1>
        <form method="post" class="auth-form v2-auth-form single-auth-form">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="validation-box"></div>
            <input asp-for="EmailOrPhone" placeholder="Nhập email hoặc số điện thoại" />
            <span asp-validation-for="EmailOrPhone"></span>
            <input asp-for="MatKhau" placeholder="Mật khẩu" />
            <span asp-validation-for="MatKhau"></span>
            <button class="btn dark-btn full-btn">Đăng nhập</button>
        </form>
        <div class="auth-bottom-links auth-bottom-split">
            <a asp-controller="Account" asp-action="Register">Tạo tài khoản mới</a>
            <a asp-controller="Admin" asp-action="Login">Đăng nhập Admin</a>
        </div>
    </div>
</section>