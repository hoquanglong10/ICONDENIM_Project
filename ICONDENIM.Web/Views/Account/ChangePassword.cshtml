@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
}
<section class="listing-hero compact"><span class="eyebrow">Security</span><h1>Đổi mật khẩu</h1><p>Khách hàng có thể thay đổi mật khẩu để bảo vệ tài khoản.</p></section>
<form asp-action="ChangePassword" method="post" class="form-card narrow">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <label>Mật khẩu hiện tại</label><input asp-for="MatKhauCu" /> <span asp-validation-for="MatKhauCu"></span>
    <label>Mật khẩu mới</label><input asp-for="MatKhauMoi" /> <span asp-validation-for="MatKhauMoi"></span>
    <label>Nhập lại mật khẩu mới</label><input asp-for="NhapLaiMatKhauMoi" /> <span asp-validation-for="NhapLaiMatKhauMoi"></span>
    <button class="btn">Lưu mật khẩu mới</button>
</form>
