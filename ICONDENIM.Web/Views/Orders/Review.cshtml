@model ReviewCreateViewModel
@{
    ViewData["Title"] = "Đánh giá sản phẩm";
}
<section class="listing-hero compact"><span class="eyebrow">Review</span><h1>Đánh giá sản phẩm</h1><p>Đánh giá sẽ được hiển thị sau khi Admin duyệt.</p></section>
<form asp-action="Review" method="post" class="form-card narrow">
    <input asp-for="donHangID" type="hidden" />
    <input asp-for="sanPhamID" type="hidden" />
    <label asp-for="soSao">Số sao</label>
    <select asp-for="soSao"><option>5</option><option>4</option><option>3</option><option>2</option><option>1</option></select>
    <label asp-for="noiDung">Nội dung đánh giá</label>
    <textarea asp-for="noiDung"></textarea>
    <button class="btn">Gửi đánh giá</button>
</form>
