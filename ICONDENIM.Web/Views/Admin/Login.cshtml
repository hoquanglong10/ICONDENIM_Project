@model LoginViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Đăng nhập Admin";
}
<section class="auth-page admin-auth-page">
    <div class="auth-card">
        <span class="eyebrow">Admin Portal</span>
        <h1>Đăng nhập quản trị</h1>
        <p class="muted">Khu vực dành cho quản trị viên. Admin không cần đăng ký tài khoản từ website.</p>
        <form method="post" class="auth-form">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="validation-box"></div>
            <label asp-for="EmailOrPhone"></label>
            <input asp-for="EmailOrPhone" placeholder="admin@icondenim.vn" />
            <span asp-validation-for="EmailOrPhone"></span>
            <label asp-for="MatKhau"></label>
            <input asp-for="MatKhau" placeholder="Mật khẩu Admin" />
            <span asp-validation-for="MatKhau"></span>
            <button class="btn full-btn">Vào trang quản trị</button>
        </form>
        <a class="admin-login-switch" asp-controller="Account" asp-action="Login">Quay lại đăng nhập khách hàng</a>
        <p class="hint-box">Tài khoản demo Admin: <b>admin@icondenim.vn</b> / <b>123456</b></p>
    </div>
</section>
