@model HomeViewModel
@{
    ViewData["Title"] = "Trang chủ";
    var heroBanner = Model.Banners.FirstOrDefault()?.hinhAnh ?? "/images/banner/banner-denim.jpg";
}
<section class="icdn-home-hero">
    <button class="hero-arrow left" type="button" aria-label="Banner trước">‹</button>
    <div class="hero-voucher-column">
        <div class="voucher-card small">
            <span>Voucher</span>
            <b>7%</b>
            <p>Tối đa 77K<br />toàn bộ sản phẩm</p>
        </div>
        <div class="voucher-card">
            <span>Flashsale</span>
            <b>77K</b>
            <p>Giờ vàng 0H · 12H · 21H</p>
        </div>
    </div>

    <div class="hero-sale-copy">
        <h1>DOUBLE DAY 7.7</h1>
        <div class="sale-date">06.07 - 09.07</div>
        <div class="deal-box">
            <span>Deal nổi bật từ</span>
            <strong>-77K</strong>
            <p>Voucher cộng dồn đến <b>177K</b></p>
        </div>
        <div class="hero-benefit-line">
            <span>Membership lên đến 15%</span>
            <span>Freeship đơn từ 77K</span>
            <span>Chỉ áp dụng online</span>
        </div>
    </div>

    <div class="hero-model">
        <img src="@heroBanner" alt="ICONDENIM Double Day 7.7" />
    </div>
    <button class="hero-arrow right" type="button" aria-label="Banner sau">›</button>
    <div class="hero-dots"><i></i><i></i><i></i><i></i></div>
</section>

<section class="icdn-policy-row">
    <div>
        <span class="policy-icon">▱</span>
        <strong>Miễn phí vận chuyển</strong>
        <p>đơn từ 77K</p>
    </div>
    <div>
        <span class="policy-icon">↺</span>
        <strong>Đổi hàng tận nhà</strong>
        <p>Trong vòng 15 ngày</p>
    </div>
    <div>
        <span class="policy-icon">COD</span>
        <strong>Thanh toán COD</strong>
        <p>Yên tâm mua sắm</p>
    </div>
    <div>
        <span class="policy-icon">☎</span>
        <strong>Hotline: 028.73066.060</strong>
        <p>Hỗ trợ bạn từ 8h30-24h00</p>
    </div>
</section>

@if (Model.DanhMucs.Any())
{
    <section class="icdn-category-section">
        <div class="icdn-section-title">
            <h2>Danh mục nổi bật</h2>
            <a asp-controller="Products" asp-action="Search">Xem tất cả</a>
        </div>
        <div class="icdn-category-grid">
            @foreach (var dm in Model.DanhMucs.Take(5))
            {
                <a asp-controller="Products" asp-action="Search" asp-route-danhMucID="@dm.danhMucID">@dm.tenDanhMuc</a>
            }
        </div>
    </section>
}

<section class="icdn-product-section">
    <div class="icdn-section-title">
        <h2>Hàng hot</h2>
        <a asp-controller="Products" asp-action="Search" asp-route-hangHot="true">Xem tất cả</a>
    </div>
    <div class="product-grid clean-product-grid">@foreach (var p in Model.HangHot) { <partial name="_ProductCard" model="p" /> }</div>
</section>

<section class="icdn-product-section">
    <div class="icdn-section-title">
        <h2>Hàng bán chạy</h2>
        <a asp-controller="Products" asp-action="Search" asp-route-banChay="true">Xem tất cả</a>
    </div>
    <div class="product-grid clean-product-grid">@foreach (var p in Model.HangBanChay) { <partial name="_ProductCard" model="p" /> }</div>
</section>

<section class="icdn-product-section">
    <div class="icdn-section-title">
        <h2>Sản phẩm mới nhất</h2>
        <a asp-controller="Products" asp-action="Search">Xem tất cả</a>
    </div>
    <div class="product-grid clean-product-grid">@foreach (var p in Model.TatCaSanPham) { <partial name="_ProductCard" model="p" /> }</div>
</section>
