@model List<DonHang>
@{
    ViewData["Title"] = "Quản lý đơn hàng";
}
<section class="admin-panel">
    <div class="panel-header"><div><span class="eyebrow">Orders</span><h2>Danh sách đơn hàng</h2></div></div>
    <form method="get" class="admin-filter multi">
        <input type="date" name="tuNgay" value="@ViewBag.TuNgay" />
        <input type="date" name="denNgay" value="@ViewBag.DenNgay" />
        <select name="trangThai">
            <option value="">Tất cả đơn hàng</option><option>ChoXacNhan</option><option>DaDuyet</option><option>DangGiao</option><option>GiaoThanhCong</option><option>GiaoThatBai</option><option>DaHuy</option>
        </select>
        <select name="trangThaiGiaoHang"><option value="">Tất cả giao hàng</option><option>ChuaGiao</option><option>DangGiao</option><option>GiaoThanhCong</option><option>GiaoThatBai</option></select>
        <select name="phuongThucThanhToan"><option value="">Tất cả thanh toán</option><option>COD</option><option>VNPay</option><option>MoMo</option><option>Banking</option></select>
        <select name="daThuTien"><option value="">Tất cả công nợ</option><option value="true">Đã thu tiền</option><option value="false">Chưa thu tiền</option></select>
        <button class="btn btn-dark">Lọc đơn</button>
        <a class="btn btn-glass" asp-controller="AdminRevenue" asp-action="Index">Thống kê doanh thu</a>
    </form>
    <div class="table-card">
        <table class="modern-table">
            <thead><tr><th>Mã đơn</th><th>Khách hàng</th><th>Ngày đặt</th><th>Trạng thái</th><th>Thanh toán</th><th>Giao hàng</th><th>Thành tiền</th><th>Thao tác</th></tr></thead>
            <tbody>
            @foreach (var d in Model)
            {
                <tr>
                    <td><b>@d.maDonHang</b></td>
                    <td>@(d.NguoiDung?.hoTen ?? d.tenKhachVangLai ?? d.hoTenNhan)<br/><small>@d.sdtNhan</small></td>
                    <td>@d.ngayDat.ToString("dd/MM/yyyy")</td>
                    <td><span class="mini-badge">@d.trangThaiDonHang</span></td>
                    <td>@d.phuongThucThanhToan<br/><small>@(d.daThuTien ? "Đã thu" : "Chưa thu")</small></td>
                    <td>@d.trangThaiGiaoHang<br/><small>@(d.NguoiGiao?.hoTen ?? "Chưa phân công")</small></td>
                    <td><b>@d.thanhTien.ToString("N0") đ</b></td>
                    <td class="actions-cell">
                        <a asp-action="Details" asp-route-id="@d.donHangID">Chi tiết</a>
                        <a asp-action="EditStatus" asp-route-id="@d.donHangID">Cập nhật</a>
                        @if (d.trangThaiDonHang == "ChoXacNhan")
                        {
                            <form asp-action="Approve" method="post" class="inline"><input type="hidden" name="id" value="@d.donHangID"/><button class="link-button">Duyệt</button></form>
                        }
                        @if (d.trangThaiDonHang != "DaHuy" && d.trangThaiDonHang != "GiaoThanhCong")
                        {
                            <form asp-action="Cancel" method="post" class="inline"><input type="hidden" name="id" value="@d.donHangID"/><button class="link-button danger">Hủy</button></form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
